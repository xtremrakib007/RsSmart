# Copy to .env in this directory before running:
#   docker compose -f docker-compose.prod.yml up -d
# All values here are consumed by docker-compose.prod.yml.

# Image tag to deploy (set by CI to the git SHA or release tag)
TAG=latest

# Postgres primary
DB_PASSWORD=change-me-generate-a-strong-random-value

# Postgres streaming replica
REPLICA_PASSWORD=change-me-generate-a-different-strong-random-value

# Redis (requirepass) — must match REDIS_PASSWORD in backend/.env
REDIS_PASSWORD=change-me-generate-a-strong-random-value

# Sentry (optional but recommended in prod)
SENTRY_DSN=
