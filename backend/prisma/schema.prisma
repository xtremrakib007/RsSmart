// ─── BILLING: Subscription Plans & Subscriptions (Phase 14) ────────────
//
// DB foundation only per roadmap Phase 14 — no service/API/payment logic
// here (see Phase 15/17/20/21). SubscriptionPlan is a global catalog
// (not tenant-scoped: every company picks from the same plan list).
// Subscription is tenant-scoped and intentionally one-to-many so plan
// changes/renewals keep history instead of being overwritten in place;
// "current" subscription = most recent row for a tenant, which Phase 15's
// service layer is responsible for resolving. `clientTransactionId`-style
// idempotency and cancellation/offboarding semantics are explicitly out of
// scope here per PHASE13_AUDIT.md (revisit at Phase 25 / Phase 15 design).

model SubscriptionPlan {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  description   String?
  priceMonthly  Decimal  @map("price_monthly") @db.Decimal(12, 2)
  currency      String   @default("MYR")
  // Basic plan limits (Phase 16 entitlement service reads these).
  maxOutlets    Int      @map("max_outlets")
  maxUsers      Int      @map("max_users")
  maxPosDevices Int      @map("max_pos_devices")
  // Feature toggles, e.g. {"whatsapp": true, "reports": false}.
  features      Json     @default("{}")
  isActive      Boolean  @default(true) @map("is_active")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id                 String             @id @default(uuid())
  tenantId           String             @map("tenant_id")
  planId             String             @map("plan_id")
  status             SubscriptionStatus @default(TRIALING)
  trialEndsAt        DateTime?          @map("trial_ends_at")
  currentPeriodStart DateTime?          @map("current_period_start")
  currentPeriodEnd   DateTime?          @map("current_period_end")
  cancelAtPeriodEnd  Boolean            @default(false) @map("cancel_at_period_end")
  cancelledAt        DateTime?          @map("cancelled_at")
  suspendedAt        DateTime?          @map("suspended_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  checkouts SubscriptionCheckout[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("subscriptions")
}

// ─── BILLING: Subscription Checkouts (Phase 21) ─────────────────────────
//
// The persistence Phase 20 deliberately deferred (see PHASE20 doc's "Do
// not"/"Known gap"): a local mapping from a payment provider's own
// reference back to the tenant/subscription/plan it belongs to. Without
// this row existing BEFORE a webhook can arrive, there is no way for the
// webhook handler to check that a `providerReference` it's told about
// actually belongs to the tenant it claims to, or to tell a replayed
// webhook from a new one. One row per checkout attempt (not per
// subscription) — a tenant can retry a failed checkout, and each attempt
// gets its own provider reference and its own row.
model SubscriptionCheckout {
  id                 String         @id @default(uuid())
  tenantId           String         @map("tenant_id")
  subscriptionId     String         @map("subscription_id")
  planId             String         @map("plan_id")
  provider           String
  // The provider's own checkout/bill id. Unique across ALL tenants — this
  // is what a webhook arrives keyed on, and is exactly the lookup that
  // lets the webhook handler resolve "which tenant is this for" without
  // trusting anything else in the webhook payload.
  providerReference  String         @unique @map("provider_reference")
  status             CheckoutStatus @default(PENDING)
  amount             Decimal        @db.Decimal(12, 2)
  currency           String         @default("MYR")
  checkoutUrl        String         @map("checkout_url")
  // Set only once a webhook has moved this row out of PENDING. A second
  // webhook for the same providerReference, once this is set, is a
  // replay/duplicate delivery (providers retry webhooks) and is a no-op —
  // not an error, not reprocessed.
  webhookProcessedAt DateTime?      @map("webhook_processed_at")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("subscription_checkouts")
}

// ─── LEGAL: Immutable policy acceptance evidence ───────────────────────────
model PolicyAcceptance {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  userId         String   @map("user_id")
  policyKey      String   @map("policy_key")
  policyTitle    String   @map("policy_title")
  policyVersion  String   @map("policy_version")
  contentHash    String   @map("content_hash")
  action         String
  flow           String
  subscriptionId String?  @map("subscription_id")
  acceptedAt     DateTime @default(now()) @map("accepted_at")
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([tenantId, userId, policyKey, policyVersion, flow, subscriptionId])
  @@index([tenantId, acceptedAt])
  @@index([tenantId, subscriptionId])
  @@map("policy_acceptances")
}

