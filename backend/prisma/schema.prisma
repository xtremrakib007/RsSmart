// prisma/schema.prisma
// Central Database Schema for Multi-Tenant Business System

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["omitApi"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── CORE: Tenants & Users ──────────────────────────────────


enum WhatsAppTemplateStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
  PAUSED
  DELETED
}

model Tenant {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  status      TenantStatus @default(ACTIVE)
  settings    Json?    @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       User[]
  roles       Role[]
  products    Product[]
  categories  Category[]
  units       Unit[]
  customers   Customer[]
  customerVisits CustomerVisit[]
  orders      Order[]
  whatsappCarts WhatsAppCart[]
  inventory   Inventory[]
  posSessions PosSession[]
  posCashMovements PosCashMovement[]
  syncEvents  SyncEvent[]
  auditLogs   AuditLog[]
  deviceTokens DeviceToken[]
  outlets     Outlet[]
  userOutlets UserOutlet[]
  userRoles   UserRole[]
  stockMovements StockMovement[]
  whatsAppAccounts WhatsAppAccount[]
  whatsAppContacts WhatsAppContact[]
  whatsAppConversations WhatsAppConversation[]
  whatsAppMessages WhatsAppMessage[]
  whatsappCampaigns WhatsAppCampaign[]
  whatsappAutomationRules WhatsAppAutomationRule[]
  whatsappCampaignRecipients WhatsAppCampaignRecipient[]
  whatsAppTemplates WhatsAppTemplate[]
  syncAcks    SyncAck[]
  webhookDeliveries WebhookDelivery[]
  salesTargets SalesTarget[]
  routePlans RoutePlan[]
  attendanceRecords AttendanceRecord[]
  subscriptions Subscription[]
  invitations Invitation[]
  subscriptionCheckouts SubscriptionCheckout[]
  policyAcceptances PolicyAcceptance[]

  @@map("tenants")
}

model User {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  email       String
  password    String   // bcrypt hashed
  firstName   String   @map("first_name")
  lastName    String   @map("last_name")
  phone       String?
  avatar      String?
  status      UserStatus @default(ACTIVE)
  lastLoginAt DateTime? @map("last_login_at")
  // Bumped whenever role/permission assignments change or an admin force-disables
  // the account, so JWTs issued before the change stop being trusted even though
  // they haven't technically expired yet (see JwtStrategy).
  tokenVersion Int      @default(0) @map("token_version")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roles       UserRole[]
  orders      Order[]  @relation("SalesRep")
  posSessions PosSession[]
  auditLogs   AuditLog[]
  deviceTokens DeviceToken[]
  outlets     UserOutlet[]
  whatsAppAccounts WhatsAppAccount[] @relation("WhatsAppAccountCreatedBy")
  whatsAppContacts WhatsAppContact[] @relation("WhatsAppContactCreatedBy")
  whatsAppConversations WhatsAppConversation[] @relation("WhatsAppConversationAssignee")
  whatsappCampaigns WhatsAppCampaign[] @relation("WhatsAppCampaignCreatedBy")
  whatsAppTemplates WhatsAppTemplate[] @relation("WhatsAppTemplateCreatedBy")
  salesTargets SalesTarget[] @relation("SalesTargetUser")
  routePlans RoutePlan[] @relation("RoutePlanUser")
  attendanceRecords AttendanceRecord[] @relation("AttendanceUser")
  whatsappAutomationRules WhatsAppAutomationRule[] @relation("WhatsAppAutomationCreatedBy")
  invitationsSent Invitation[] @relation("InvitationInvitedBy")
  policyAcceptances PolicyAcceptance[]
  // Note: WhatsAppMessage.createdBy is intentionally a plain nullable String,
  // not a relation (same unenforced "actor" pattern as
  // StockMovement.createdBy / PosCashMovement.createdBy — it can be null
  // for inbound/system/bot messages). There is deliberately no
  // `whatsAppMessages WhatsAppMessage[]` field here; one existed pointing
  // at a `@relation("WhatsAppMessageCreatedBy")` that WhatsAppMessage never
  // declared, which is a Prisma schema-validation error (found during the
  // Phase 13 audit hotfix, 2026-08-30).

  @@unique([tenantId, email])
  @@map("users")
}

model DeviceToken {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  deviceId  String   @map("device_id") // matches SyncEvent.clientId for the same physical device
  token     String   // FCM registration token — rotates, so it's not the primary key
  platform  String   @default("ANDROID")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One row per physical device; re-registering (token rotation) updates it.
  @@unique([tenantId, deviceId])
  @@index([userId])
  @@map("device_tokens")
}

model Role {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  permissions Json     @default("[]") // Array of permission strings, see common/permissions/permission.enum.ts
  // If true, holders of this role act tenant-wide and are not restricted to
  // their assigned outlets (see UserOutlet) for outlet-scoped resources.
  scopeAllOutlets Boolean @default(false) @map("scope_all_outlets")
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users       UserRole[]

  @@unique([tenantId, name])
  @@map("roles")
}

model UserRole {
  id        String   @id @default(uuid())
  // Denormalized from Role.tenantId (roleId always belongs to the same
  // tenant as the assignment — enforced in users.service.assignRoles).
  // Kept here too so this table can be filtered/indexed by tenant on its
  // own, without requiring a join through roles for every query.
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([tenantId])
  @@index([roleId])
  @@map("user_roles")
}

// ─── INVITATIONS: Employee onboarding (Phase 19) ───────────
// A pending offer for someone to join an EXISTING tenant, distinct from
// AuthService.registerCompany (which always creates a brand new tenant) and
// from the old direct-create AuthService.inviteUser (which required the
// inviter to choose the new employee's password up front — see
// InvitationsService for why this replaces that as the primary flow).
// Only the sha256 hash of the raw token is ever persisted; the raw token
// exists solely in the API response at creation time and in the link sent
// to the invitee, the same "only visible once" pattern as an API key.

model Invitation {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  email          String
  firstName      String   @map("first_name")
  lastName       String   @map("last_name")
  // Snapshotted at invite time as plain arrays of ids (not a join table —
  // there is nothing to query these by until the invitation is accepted,
  // at which point they become real UserRole/UserOutlet rows).
  roleIds        Json     @map("role_ids") // string[]
  outletIds      Json     @map("outlet_ids") // string[]
  tokenHash      String   @unique @map("token_hash")
  status         InvitationStatus @default(PENDING)
  invitedByUserId String  @map("invited_by_user_id")
  expiresAt      DateTime @map("expires_at")
  acceptedAt     DateTime? @map("accepted_at")
  acceptedUserId String?  @map("accepted_user_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy      User     @relation("InvitationInvitedBy", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, email])
  @@map("invitations")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

// ─── OUTLETS: Company → Outlet/Branch hierarchy ────────────
// Platform → Company/Tenant → Outlet/Branch → POS/Inventory/Sales.
// Company-level: users, roles, product catalog, customers, pricing, taxes,
// subscription. Outlet-level: stock, POS terminals/sessions, cash, and
// operational sales records (see Phase 11 of the SaaS roadmap).

model Outlet {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  code      String   // short human code, unique per tenant e.g. "HQ", "JB-01"
  name      String
  address   String?
  timezone  String   @default("Asia/Kuala_Lumpur")
  currency  String   @default("MYR")
  // Every tenant has exactly one default outlet (created at signup / backfilled
  // for pre-existing tenants) that legacy/un-scoped records resolve to.
  isDefault Boolean  @default(false) @map("is_default")
  status    OutletStatus @default(ACTIVE)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userOutlets UserOutlet[]
  inventory Inventory[]
  stockMovements StockMovement[]
  posSessions PosSession[]
  posCashMovements PosCashMovement[]
  orders    Order[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("outlets")
}

enum OutletStatus {
  ACTIVE
  INACTIVE
}

model UserOutlet {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  userId     String   @map("user_id")
  outletId   String   @map("outlet_id")
  isDefault  Boolean  @default(false) @map("is_default")
  assignedAt DateTime @default(now()) @map("assigned_at")

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  outlet     Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([userId, outletId])
  @@index([tenantId, outletId])
  @@map("user_outlets")
}

// ─── INVENTORY: Products ───────────────────────────────────

model Product {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  sku         String
  name        String
  description String?
  barcode     String?
  categoryId  String?  @map("category_id")
  unitId      String?  @map("unit_id")
  basePrice   Decimal  @map("base_price") @db.Decimal(12, 2)
  costPrice   Decimal? @map("cost_price") @db.Decimal(12, 2)
  taxRate     Decimal  @default(0) @map("tax_rate") @db.Decimal(5, 2)
  isActive    Boolean  @default(true) @map("is_active")
  trackInventory Boolean @default(true) @map("track_inventory")
  minStock    Decimal? @map("min_stock") @db.Decimal(12, 3)
  maxStock    Decimal? @map("max_stock") @db.Decimal(12, 3)
  attributes  Json?    @default("{}") // { color: "red", size: "XL" }
  images      Json?    @default("[]")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category    Category? @relation(fields: [categoryId], references: [id])
  unit        Unit?    @relation(fields: [unitId], references: [id])
  inventory   Inventory[]
  orderItems  OrderItem[]
  whatsappCartItems WhatsAppCartItem[]

  @@unique([tenantId, sku])
  @@map("products")
}

model Category {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  parentId    String?  @map("parent_id")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products    Product[]
  parent      Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")

  @@index([tenantId])
  @@map("categories")
}

model Unit {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String   // e.g., "Piece", "Kg", "Box"
  symbol    String   // e.g., "pcs", "kg", "box"
  createdAt DateTime @default(now()) @map("created_at")

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products  Product[]

  @@index([tenantId])
  @@map("units")
}

model Inventory {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  outletId  String   @map("outlet_id")
  productId String   @map("product_id")
  warehouseId String? @map("warehouse_id") // sub-location within the outlet
  quantity  Decimal  @db.Decimal(12, 3)
  reserved  Decimal  @default(0) @db.Decimal(12, 3)
  // Phase 26: optimistic locking version. Incremented on every write;
  // updateMany with the old version acts as a compare-and-swap.
  version   Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outlet    Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  movements StockMovement[]

  // Stock is tracked per outlet: the same product has an independent
  // Inventory row (and quantity) at each outlet.
  @@unique([tenantId, outletId, productId, warehouseId])
  @@index([tenantId, outletId])
  @@map("inventory")
}

model StockMovement {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  outletId    String   @map("outlet_id")
  inventoryId String   @map("inventory_id")
  type        MovementType
  quantity    Decimal  @db.Decimal(12, 3)
  referenceId String?  @map("reference_id") // order_id, purchase_id, etc.
  referenceType String? @map("reference_type")
  notes       String?
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outlet      Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([tenantId, outletId, createdAt])
  @@map("stock_movements")
}

// ─── SALES: Customers & Orders ─────────────────────────────

model Customer {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  code        String?
  name        String
  email       String?
  phone       String?
  address     String?
  city        String?
  state       String?
  country     String?
  latitude    Decimal? @db.Decimal(10, 8)
  longitude   Decimal? @db.Decimal(11, 8)
  creditLimit Decimal? @map("credit_limit") @db.Decimal(12, 2)
  balance     Decimal  @default(0) @db.Decimal(12, 2)
  category    String?  // VIP, Regular, etc.
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders      Order[]
  visits      CustomerVisit[]
  whatsAppContacts WhatsAppContact[]

  @@map("customers")
}
// Note: a `whatsappCarts WhatsAppCart[]` field used to live here, but
// WhatsAppCart has no customerId column or relation back to Customer at
// all (a cart links to a WhatsAppContact, which optionally links to a
// Customer) — this was another dangling relation Prisma would reject.
// Removed rather than added-to, since nothing in the codebase reads
// `customer.whatsappCarts` (found during the Phase 13 audit hotfix,
// 2026-08-30). If a direct customer -> cart lookup is ever needed, go
// through WhatsAppContact.customerId instead.

model CustomerVisit {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  customerId  String   @map("customer_id")
  userId      String   @map("user_id")
  checkInAt   DateTime @map("check_in_at")
  checkOutAt  DateTime? @map("check_out_at")
  latitude    Decimal? @db.Decimal(10, 8)
  longitude   Decimal? @db.Decimal(11, 8)
  notes       String?
  photos      Json?    @default("[]")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId])
  @@index([userId])
  @@map("customer_visits")
}

model Order {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  outletId    String   @map("outlet_id")
  orderNumber String   @map("order_number") // human-readable
  customerId  String   @map("customer_id")
  salesRepId  String   @map("sales_rep_id")
  status      OrderStatus @default(DRAFT)
  source      OrderSource @default(SALES_APP)
  subtotal    Decimal  @db.Decimal(12, 2)
  taxAmount   Decimal  @map("tax_amount") @db.Decimal(12, 2)
  discount    Decimal  @default(0) @db.Decimal(12, 2)
  total       Decimal  @db.Decimal(12, 2)
  paidAmount  Decimal  @default(0) @map("paid_amount") @db.Decimal(12, 2)
  balanceDue  Decimal  @default(0) @map("balance_due") @db.Decimal(12, 2)
  notes       String?
  deliveryDate DateTime? @map("delivery_date")
  approvedBy  String?  @map("approved_by")
  approvedAt  DateTime? @map("approved_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  clientTransactionId String? @map("client_transaction_id")

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outlet      Outlet   @relation(fields: [outletId], references: [id])
  customer    Customer @relation(fields: [customerId], references: [id])
  salesRep    User     @relation("SalesRep", fields: [salesRepId], references: [id])
  items       OrderItem[]
  payments    Payment[]

  @@unique([tenantId, clientTransactionId])
  @@index([tenantId, outletId, createdAt])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String   @map("order_id")
  productId   String   @map("product_id")
  quantity    Decimal  @db.Decimal(12, 3)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  discount    Decimal  @default(0) @db.Decimal(12, 2)
  taxRate     Decimal  @map("tax_rate") @db.Decimal(5, 2)
  taxAmount   Decimal  @map("tax_amount") @db.Decimal(12, 2)
  total       Decimal  @db.Decimal(12, 2)
  notes       String?

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Payment {
  id          String   @id @default(uuid())
  orderId     String   @map("order_id")
  amount      Decimal  @db.Decimal(12, 2)
  method      PaymentMethod
  reference   String?  // transaction ID, cheque number
  notes       String?
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

// ─── POS: Sessions & Hardware ──────────────────────────────

model PosSession {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  outletId    String   @map("outlet_id")
  userId      String   @map("user_id")
  deviceId    String   @map("device_id")
  openedAt    DateTime @map("opened_at")
  closedAt    DateTime? @map("closed_at")
  openingCash Decimal  @map("opening_cash") @db.Decimal(12, 2)
  openingDenominations Json? @map("opening_denominations")
  closingCash Decimal? @map("closing_cash") @db.Decimal(12, 2)
  closingDenominations Json? @map("closing_denominations")
  expectedCash Decimal? @map("expected_cash") @db.Decimal(12, 2)
  discrepancy Decimal? @db.Decimal(12, 2)
  status      SessionStatus @default(OPEN)
  createdAt   DateTime @default(now()) @map("created_at")

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outlet      Outlet   @relation(fields: [outletId], references: [id])
  user        User     @relation(fields: [userId], references: [id])
  cashMovements PosCashMovement[]

  @@index([tenantId, outletId, status])
  @@map("pos_sessions")
}


model PosCashMovement {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  outletId    String   @map("outlet_id")
  sessionId   String   @map("session_id")
  type        PosCashMovementType
  amount      Decimal  @db.Decimal(12, 2)
  referenceId String?  @map("reference_id")
  notes       String?
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outlet  Outlet @relation(fields: [outletId], references: [id])
  session PosSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([tenantId, outletId, sessionId, createdAt])
  @@map("pos_cash_movements")
}


// ─── FIELD SALES: Targets, Routes & Attendance ─────────────────────────

model SalesTarget {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  userId      String   @map("user_id")
  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")
  targetAmount Decimal @map("target_amount") @db.Decimal(12, 2)
  achievedAmount Decimal @default(0) @map("achieved_amount") @db.Decimal(12, 2)
  targetOrders Int @default(0) @map("target_orders")
  achievedOrders Int @default(0) @map("achieved_orders")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User   @relation("SalesTargetUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, periodStart, periodEnd])
  @@map("sales_targets")
}

model RoutePlan {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  userId      String   @map("user_id")
  routeDate   DateTime @map("route_date")
  name        String
  status      String   @default("PLANNED")
  customerIds Json     @default("[]") @map("customer_ids")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User   @relation("RoutePlanUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, routeDate])
  @@map("route_plans")
}

model AttendanceRecord {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  userId      String   @map("user_id")
  workDate    DateTime @map("work_date")
  checkInAt   DateTime? @map("check_in_at")
  checkOutAt  DateTime? @map("check_out_at")
  checkInLat  Decimal? @map("check_in_lat") @db.Decimal(10, 8)
  checkInLng  Decimal? @map("check_in_lng") @db.Decimal(11, 8)
  checkOutLat Decimal? @map("check_out_lat") @db.Decimal(10, 8)
  checkOutLng Decimal? @map("check_out_lng") @db.Decimal(11, 8)
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User   @relation("AttendanceUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, workDate])
  @@map("attendance_records")
}

// ─── SYNC: Event Sourcing ──────────────────────────────────

model SyncEvent {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  clientId       String   @map("client_id") // device identifier
  idempotencyKey String?  @map("idempotency_key")
  eventType      String   @map("event_type") // e.g., "order.created"
  entityType     String   @map("entity_type") // e.g., "order"
  entityId       String   @map("entity_id")
  action         SyncAction
  payload        Json
  vectorClock    Json     @map("vector_clock") // { "device_123": 45, "server": 120 }
  status         SyncStatus @default(PENDING)
  attempts       Int      @default(0)
  processedAt    DateTime? @map("processed_at")
  error          String?
  createdAt      DateTime @default(now()) @map("created_at")

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  acks        SyncAck[]

  @@unique([tenantId, clientId, idempotencyKey])
  @@index([tenantId, clientId, status])
  @@index([tenantId, entityType, entityId])
  @@map("sync_events")
}

// Phase 27: tracks which sync events each device has successfully
// received and processed. Enables pull deduplication and gives the
// server a ground-truth view of per-device sync state.
model SyncAck {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  clientId    String   @map("client_id")
  eventId     String   @map("event_id")
  ackedAt     DateTime @default(now()) @map("acked_at")

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  event       SyncEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([tenantId, clientId, eventId])
  @@index([tenantId, clientId])
  @@index([tenantId, clientId, ackedAt])
  @@map("sync_acks")
}

// Phase 28: tracks processed webhook deliveries so a provider retry
// (Meta, etc.) does not create duplicate messages or orders.
model WebhookDelivery {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  provider        String   // e.g. "META_CLOUD"
  providerEventId String   @map("provider_event_id") // message.id, status.id, etc.
  eventType       String   @map("event_type") // "message", "status", etc.
  payloadHash     String   @map("payload_hash") // sha256 of raw payload for integrity
  processedAt     DateTime @default(now()) @map("processed_at")
  httpStatus      Int      @map("http_status")
  error           String?

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([provider, providerEventId])
  @@index([tenantId, processedAt])
  @@map("webhook_deliveries")
}



// ─── AUDIT: Logs ───────────────────────────────────────────

model AuditLog {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  userId      String?  @map("user_id")
  action      String   // CREATE, UPDATE, DELETE, LOGIN, APPROVE, etc.
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  oldValues   Json?    @map("old_values")
  newValues   Json?    @map("new_values")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id])

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

