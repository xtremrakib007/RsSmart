# Database
DATABASE_URL="postgresql://user:password@localhost:5432/central_db?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_SECRET="your-refresh-secret-key"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGINS="http://localhost:3001,http://localhost:5173"
# API docs are enabled outside production. In production, keep false unless
# Swagger is protected by your reverse proxy / identity access controls.
SWAGGER_ENABLED=false

# Redis (cache, BullMQ queues, sync engine)
REDIS_HOST="localhost"
REDIS_PORT=6379
# Required in staging/production — see infrastructure/docker-compose.prod.yml,
# which now sets `redis-server --requirepass`. Leave blank only for local dev
# if your local redis has no password set.
REDIS_PASSWORD=""

# Error tracking (backend/instrumentation.ts)
SENTRY_DSN=""
GIT_SHA=""

# Order confirmation email via SendGrid (backend/src/notifications/email.service.ts)
# Sent only for sales orders (source SALES_APP/ERP/WEB) when they reach
# APPROVED — never for POS. See NotificationsService.
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="orders@yourcompany.com"
SENDGRID_ORDER_CONFIRMATION_TEMPLATE_ID=""

# Order confirmation via WhatsApp using Twilio's WhatsApp Business API
# (backend/src/notifications/whatsapp.service.ts). Same POS-exclusion rule
# as email above. TWILIO_WHATSAPP_NUMBER must be an approved WhatsApp
# sender, e.g. "whatsapp:+14155238886" (Twilio sandbox number for dev/test).
TWILIO_SID=""
TWILIO_TOKEN=""
TWILIO_WHATSAPP_NUMBER=""

# Push notifications via Firebase Admin (backend/src/push/push.service.ts)
# Full service-account JSON as a single-line string. Must be from the SAME
# Firebase project as sales-android/app/google-services.json — see
# sales-android/FIREBASE_SETUP.md.
FIREBASE_SERVICE_ACCOUNT=""

# File Storage (MinIO/S3)
STORAGE_ENDPOINT="localhost"
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY="minioadmin"
STORAGE_SECRET_KEY="minioadmin"
STORAGE_BUCKET="central-app"

# WhatsApp Cloud API (provider=META_CLOUD)
META_GRAPH_VERSION=v23.0
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_VERIFY_TOKEN=

# WhatsApp production security
# Generate a high-entropy secret and keep it outside source control.
WHATSAPP_CREDENTIAL_ENCRYPTION_KEY=
META_APP_SECRET=
META_WHATSAPP_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0

# Payments (backend/src/payments) — Phase 20/21
# PAYMENT_PROVIDER selects which adapter PaymentsModule binds to. Leave as
# 'mock' for dev/test; an unrecognized value fails loud at boot rather than
# silently falling back to the mock (see payments.module.ts).
PAYMENT_PROVIDER=mock

# Billplz (Malaysian FPX/DuitNow bank-transfer collection). Only needed
# when PAYMENT_PROVIDER=billplz.
# BILLPLZ_API_KEY: the collection's API Secret Key from the Billplz dashboard.
# BILLPLZ_COLLECTION_ID: which Billplz collection new bills are created under.
# BILLPLZ_X_SIGNATURE_KEY: a SEPARATE secret (also from the dashboard) used
#   only to verify webhook/redirect signatures — never sent to the create-bill API.
# BILLPLZ_BASE_URL: use https://www.billplz-sandbox.com for testing; defaults
#   to the production https://www.billplz.com if unset.
# BILLPLZ_CALLBACK_URL: this backend's public webhook URL, e.g.
#   https://api.yourapp.com/v1/payments/webhook/billplz — Billplz calls this
#   server-to-server; it is never the same as the browser redirect_url.
BILLPLZ_API_KEY=
BILLPLZ_COLLECTION_ID=
BILLPLZ_X_SIGNATURE_KEY=
BILLPLZ_BASE_URL=https://www.billplz-sandbox.com
BILLPLZ_CALLBACK_URL=
